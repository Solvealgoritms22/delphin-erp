DATABASE_URL="postgresql://dolphin:dolphin_password@localhost:5432/dolphin_erp?schema=public"
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/v1/backups/google/callback
FRONTEND_URL=http://localhost:4200
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200,http://localhost:3873
REDIS_URL=redis://localhost:6379

# Notifications email channel: smtp or resend.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=""
RESEND_FROM=""

# Web Push channel.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=mailto:admin@dolphin-erp.com

# Required for authentication. Generate a unique value in every environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Backups: 32 bytes encoded as base64 or 64 hexadecimal characters.
BACKUP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
BACKUP_STORAGE_PATH="./var/backups"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@dolphin-erp.local"

# Azul: MOCK for local development, TESTING or PRODUCTION for the gateway.
AZUL_ENV=MOCK
AZUL_MERCHANT_ID=""
AZUL_AUTH1=""
AZUL_AUTH2=""

MAINTENANCE_MODE=false
MAINTENANCE_TENANT_ID=""

# AI Agent & Assistant Configuration (100% Free models supported out of the box)
# Leave empty to use free Pollinations AI Gateway / Smart Heuristic Engine automatically.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"
GEMINI_API_KEY=""
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
