{
  "name": "dolphin-erp",
  "version": "1.0.11",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:desktop": "npm start --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "start:api": "npm run start:dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "dev": "npm run start:api & npm run start:desktop"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "js-yaml": "5.3.0",
    "linkify-it": "5.0.2",
    "mailparser": "3.9.15",
    "nanoid": "3.3.18",
    "nodemailer": "9.0.5"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.0"
  }
}
