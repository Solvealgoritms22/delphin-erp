{
  "name": "dolphin-erp",
  "version": "1.0.13",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:desktop": "npm start --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "start:api": "npm run start:dev --workspace=apps/api",
    "start:dev": "npm run start:api",
    "build:api": "npm run build --workspace=apps/api",
    "db:deploy": "npm run db:deploy --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "dev": "npm run start:api & npm run start:desktop"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "js-yaml": "4.3.2",
    "linkify-it": "5.0.2",
    "mailparser": "3.9.15",
    "nanoid": "3.3.18",
    "nodemailer": "9.1.1",
    "multer": "2.3.0",
    "qs": "6.16.0",
    "svgo": "4.1.0"
  },
  "devDependencies": {
    "@angular/compiler": "22.1.6"
  }
}
